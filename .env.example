# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat (Project → API keys → Public app-specific)
VITE_RC_ANDROID_KEY=goog_xxx_your_android_public_key
# Set later when iOS is enabled
VITE_RC_IOS_KEY=

# OAuth redirect (must match Supabase Auth → URL Configuration → Redirect URLs,
# and match the Android intent-filter data scheme/host in AndroidManifest.xml)
VITE_OAUTH_REDIRECT_URL=io.wakbu.slime://auth/callback

# Entitlement identifier configured in RevenueCat
VITE_RC_ENTITLEMENT_ID=premium

# Daily free-usage cap (before paywall)
VITE_FREE_DAILY_LIMIT=5

# AdMob Ad Unit IDs (Android)
#   Banner       → ca-app-pub-XXXXXXXXXXXXXXXX/BANNER_ID
#   Interstitial → ca-app-pub-XXXXXXXXXXXXXXXX/INTERSTITIAL_ID
#   App ID is in android/app/src/main/AndroidManifest.xml (not here)
VITE_ADMOB_ANDROID_BANNER=ca-app-pub-XXXXXXXXXXXXXXXX/BANNER_ID
VITE_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/INTERSTITIAL_ID
# Dev/testing: set to true to force Google's always-filled test ads
# instead of your real units (also enabled automatically in dev mode).
VITE_ADMOB_TESTING=false
